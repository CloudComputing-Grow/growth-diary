const axios = require('axios');

const API_GATEWAY_URL = process.env.API_GATEWAY_URL || 'http://api-gateway';
const ACHIEVEMENT_INTERNAL_PATH =
  process.env.ACHIEVEMENT_INTERNAL_PATH || '/internal/achievements';

const achievementService = {
  // 수확한 과일 도감 등록
  async updateCollectionByHarvest({ userId, itemTypeId }) {
    try {
      const response = await axios.post(
        `${API_GATEWAY_URL}${ACHIEVEMENT_INTERNAL_PATH}`,
        {
          userId,
          itemTypeId,
          achievedBy: 'HARVEST',
        }
      );

      return response.data;
    } catch (error) {
      console.error(
        `[Internal Error] achievementService.updateCollectionByHarvest 실패: ${error.message}`
      );
      throw error;
    }
  },
};

module.exports = achievementService;