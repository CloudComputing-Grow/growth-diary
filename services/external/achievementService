const axios = require('axios');

const ACHIEVEMENT_SERVER_URL =
  process.env.ACHIEVEMENT_SERVER_URL || 'http://localhost:3002';

const achievementService = {
  async updateCollectionByHarvest({ userId, itemTypeId }) {
    try {
      const response = await axios.post(
        `${ACHIEVEMENT_SERVER_URL}/internal/achievements`,
        {
          userId,
          itemTypeId,
          achievedBy: 'HARVEST',
        }
      );

      return response.data;
    } catch (error) {
      console.error(
        `[External Error] achievementService.updateCollectionByHarvest 실패: ${error.message}`
      );
      throw error;
    }
  },
};

module.exports = achievementService;