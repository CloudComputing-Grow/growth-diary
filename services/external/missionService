const axios = require('axios');

const INTERNAL_API_URL =
  (process.env.API_GATEWAY_URL || 'http://api-gateway') + '/api/internal/v1';

const missionService = {
  // missionExecutionId가 현재 유저의 완료된 미션인지 확인
  async checkMissionCompleted({ userId, missionExecutionId }) {
    try {
      const response = await axios.get(
        `${INTERNAL_API_URL}/missions/executions/${missionExecutionId}/status`,
        {
          headers: {
            'x-user-id': userId,
          },
        }
      );

      return response.data?.data || response.data;
    } catch (error) {
      console.error(
        `[Internal Error] missionService.checkMissionCompleted 실패: ${error.message}`
      );
      throw error;
    }
  },
};

module.exports = missionService;